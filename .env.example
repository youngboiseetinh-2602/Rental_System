# MySQL database used by the backend.
DB_URL=jdbc:mysql://localhost:3306/rental_room_system?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
FLYWAY_ENABLED=false

# One backend both issues JWTs and validates them for /api/**.
SERVER_PORT=8080
AUTH_SERVER_ISSUER=http://localhost:8080
FRONTEND_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login
RENTAL_SPA_CLIENT_ID=rental-spa
RENTAL_SPA_REDIRECT_URI=http://localhost:3000/callback
RENTAL_SPA_POST_LOGOUT_URI=http://localhost:3000

SESSION_COOKIE_SECURE=false
AUTH_SESSION_TIMEOUT=30m

# Optional in development. Configure both PEM files in production.
AUTH_SERVER_PRIVATE_KEY_PATH=
AUTH_SERVER_PUBLIC_KEY_PATH=
AUTH_SERVER_JWT_KEY_ID=rental-auth-key-1
